{
  "name": "@astralyn/minicpa",
  "version": "0.4.3",
  "description": "Manage, run, and update one local CLIProxyAPI instance",
  "license": "MIT",
  "author": "ming-kang",
  "type": "module",
  "bin": {
    "cpa": "dist/cli.js"
  },
  "files": [
    "dist",
    "docs",
    "CHANGELOG.md"
  ],
  "scripts": {
    "hooks:install": "git config --local core.hooksPath .githooks",
    "dev": "tsx src/cli.ts",
    "check": "npm run lint && npm test && npm run build",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "typecheck": "tsc --noEmit",
    "test": "npm run typecheck && node scripts/run-tests.mjs",
    "clean:build": "node scripts/clean-build.mjs",
    "build": "npm run clean:build && tsc -p tsconfig.build.json",
    "verify:package": "node scripts/verify-package.mjs",
    "verify:package-install": "node scripts/verify-package-install.mjs",
    "audit:prod": "npm audit --omit=dev --audit-level=moderate",
    "prepublishOnly": "npm run audit:prod && npm run check"
  },
  "engines": {
    "node": ">=24"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ming-kang/MiniCPA.git"
  },
  "homepage": "https://github.com/ming-kang/MiniCPA#readme",
  "bugs": {
    "url": "https://github.com/ming-kang/MiniCPA/issues"
  },
  "keywords": [
    "cli",
    "cpa",
    "cliproxyapi",
    "cli-proxy-api",
    "proxy",
    "management",
    "update"
  ],
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "commander": "^13.1.0",
    "cross-spawn": "^7.0.6",
    "semver": "^7.8.5",
    "tar": "^7.5.22",
    "undici": "^7.30.0",
    "yaml": "^2.7.0",
    "yauzl": "^3.4.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.5",
    "@types/cross-spawn": "^6.0.6",
    "@types/node": "^26.6.5",
    "@types/semver": "^7.8.0",
    "@types/yauzl": "^3.4.0",
    "adm-zip": "^0.6.1",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2"
  }
}
